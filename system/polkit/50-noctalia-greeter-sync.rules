// /etc/polkit-1/rules.d/50-noctalia-greeter-sync.rules — scripts/setup-system.sh greeter-sync
// Noctalia syncs the wallpaper + palette to the login greeter on every palette
// change and asked for the admin password each time (three dismissed prompts
// then tripped pam_faillock's 10-minute lockout). Allow ONLY this action, for
// an active local admin session: it runs
//   /usr/bin/noctalia-greeter-apply-appearance --sync <staging dir>
// which validates its input and writes only /var/lib/noctalia-greeter.
polkit.addRule(function (action, subject) {
    if (action.id === "org.noctalia.greeter.sync-appearance" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
