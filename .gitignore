.vscode
.config/shell/local.sh
.config/systemd/user/*.target.wants/
.local/bin/hypridle

# Tool-installed binaries that end up in ~/.local/bin (never dotfiles)
.local/bin/claude
.local/bin/forgejo-mcp
.local/bin/multica
.local/bin/uv
.local/bin/uvx
.local/bin/env
.local/bin/env.fish
.local/bin/python3*

# Wallpaper-generated palettes (theme/matugen → rice-wall)
.config/theme/generated/

# Written by DankMaterialShell at runtime (not loaded by this config)
.config/hypr/dms/
.config/gtk-3.0/dank-colors.css
.config/gtk-4.0/dank-colors.css
