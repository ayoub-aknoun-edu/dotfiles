.vscode
.config/shell/local.sh
.config/systemd/user/*.target.wants/
.local/bin/hypridle

# Tool-installed binaries that end up in ~/.local/bin (never dotfiles)
.local/bin/claude
.local/bin/forgejo-mcp
.local/bin/multica
.local/bin/uv
.local/bin/uvx
.local/bin/env
.local/bin/env.fish
.local/bin/python3*

# Wallpaper-generated palettes (theme/matugen → rice-wall)
.config/theme/generated/

# Written by Noctalia's gtk3/gtk4 templates (wallpaper palette)
.config/gtk-3.0/gtk.css
.config/gtk-3.0/noctalia.css
.config/gtk-4.0/gtk.css
.config/gtk-4.0/noctalia.css
