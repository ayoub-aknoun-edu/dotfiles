#!/usr/bin/env bash
# Watch UPower D-Bus events and restart hypridle when AC state changes.
# Defers the restart until hyprlock is no longer running to avoid a
# protocol conflict that crashes Hyprland when the session lock is active.

set -euo pipefail

# Online state of the mains adapter (AC, ADP1, ACAD… — named per vendor).
ac_online() {
    local d
    for d in /sys/class/power_supply/*; do
        [[ "$(cat "$d/type" 2>/dev/null)" == Mains ]] || continue
        cat "$d/online" 2>/dev/null && return
    done
    echo 1  # desktops / unknown: treat as plugged in
}

last_state=$(ac_online)
waiter_pid=""

# Locked by either locker: Noctalia, which sets
# logind's LockedHint, or the hyprlock fallback (which doesn't).
is_locked() {
    pidof hyprlock >/dev/null 2>&1 && return 0
    local sid
    sid="$(loginctl show-user "$USER" -p Display --value 2>/dev/null || true)"
    [[ -n "$sid" && "$(loginctl show-session "$sid" -p LockedHint --value 2>/dev/null)" == yes ]]
}

do_restart() {
    # If the screen is locked, wait for it to unlock first
    while is_locked; do
        sleep 2
    done
    sleep 1  # brief settle after unlock
    systemctl --user restart hypridle.service
}

restart_if_changed() {
    local state
    state=$(ac_online)
    if [[ "$state" != "$last_state" ]]; then
        last_state="$state"
        # Cancel any previous pending restart, start a fresh one
        [[ -n "$waiter_pid" ]] && kill "$waiter_pid" 2>/dev/null || true
        do_restart &
        waiter_pid=$!
    fi
}

# Use process substitution so the while loop runs in the main shell
# (keeps last_state and waiter_pid in scope across iterations)
while IFS= read -r _; do
    restart_if_changed
done < <(upower --monitor 2>/dev/null)
