#!/usr/bin/env bash
# Switch the desktop shell layer while keeping Hyprland, hypridle/hyprlock and
# hyprsunset untouched.
#
#   rice-shell get           print the active shell
#   rice-shell set <shell>   switch to: classic | dms | noctalia
#   rice-shell next          cycle classic → dms → noctalia → classic
#   rice-shell apply         start the saved shell (called at login)
#
# classic  = waybar + eww control center + swaync + rofi + wlogout + awww
# dms      = DankMaterialShell (dms.service)
# noctalia = Noctalia (noctalia.service)

set -euo pipefail

SHELLS=(classic dms noctalia)
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rice"
STATE_FILE="$STATE_DIR/shell"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/rice-shell.lock"
EWW_LOGGER="$HOME/.config/eww/scripts/notification-daemon"
READY_TIMEOUT=15

die() { echo "rice-shell: $*" >&2; exit 1; }

cmd_get() {
    local s
    s="$(cat "$STATE_FILE" 2>/dev/null || true)"
    case "$s" in classic|dms|noctalia) echo "$s" ;; *) echo classic ;; esac
}

launch() {
    # Own systemd scope per daemon under UWSM; detached either way.
    if [[ -n "${UWSM_FINALIZE_VARNAMES:-}" ]] && command -v uwsm >/dev/null; then
        setsid -f uwsm app -- "$@" >/dev/null 2>&1
    else
        setsid -f "$@" >/dev/null 2>&1
    fi
}

wait_for() {  # wait_for <command...>: poll until it succeeds or time out
    local i
    for ((i = 0; i < READY_TIMEOUT * 10; i++)); do
        "$@" >/dev/null 2>&1 && return 0
        sleep 0.1
    done
    return 1
}

# ── classic ──────────────────────────────────────────────────────────────────
start_classic() {
    systemctl --user unmask --runtime swaync.service 2>/dev/null || true
    systemctl --user start swaync.service waybar.service
    eww ping >/dev/null 2>&1 || { launch eww daemon; wait_for eww ping || true; }
    pgrep -f "$EWW_LOGGER" >/dev/null || launch "$EWW_LOGGER"
    awww query >/dev/null 2>&1 || { launch awww-daemon; wait_for awww query || true; }
}

stop_classic() {
    # A masked unit can't be D-Bus activated, so swaync won't steal
    # org.freedesktop.Notifications back from DMS/Noctalia. Runtime-only:
    # cleared on reboot, then `apply` re-evaluates.
    systemctl --user mask --runtime swaync.service >/dev/null 2>&1 || true
    systemctl --user stop waybar.service swaync.service 2>/dev/null || true
    eww kill >/dev/null 2>&1 || true
    local pid
    for pid in $(pgrep -f "$EWW_LOGGER" || true); do
        pkill -P "$pid" 2>/dev/null || true   # its dbus-monitor child
        kill "$pid" 2>/dev/null || true
    done
    awww kill >/dev/null 2>&1 || true
}

# ── dms / noctalia ───────────────────────────────────────────────────────────
start_dms()      { systemctl --user start dms.service; wait_for dms ipc call lock isLocked || true; }
stop_dms()       { systemctl --user stop dms.service 2>/dev/null || true; }
start_noctalia() { systemctl --user start noctalia.service; wait_for noctalia msg wallpaper-get || true; }
stop_noctalia()  { systemctl --user stop noctalia.service 2>/dev/null || true; }

start_shell() {
    local target="$1" s
    # Palette files must exist before any bar/CSS that imports them starts.
    "$HOME/.local/bin/rice-wall" init || true
    for s in "${SHELLS[@]}"; do
        [[ "$s" == "$target" ]] || "stop_$s"
    done
    "start_$target"
    "$HOME/.local/bin/rice-wall" restore || true
}

cmd_set() {
    local target="${1:?usage: rice-shell set <classic|dms|noctalia>}"
    [[ " ${SHELLS[*]} " == *" $target "* ]] || die "unknown shell: $target"

    exec 9>"$LOCK_FILE"
    flock -n 9 || die "a switch is already in progress"

    mkdir -p "$STATE_DIR"
    printf '%s\n' "$target" > "$STATE_FILE"
    start_shell "$target"
    notify-send -a rice -i preferences-desktop-theme "Desktop shell" "Switched to $target" 2>/dev/null || true
}

cmd_next() {
    local current i
    current="$(cmd_get)"
    for i in "${!SHELLS[@]}"; do
        if [[ "${SHELLS[$i]}" == "$current" ]]; then
            cmd_set "${SHELLS[$(( (i + 1) % ${#SHELLS[@]} ))]}"
            return
        fi
    done
    cmd_set classic
}

cmd_apply() {
    exec 9>"$LOCK_FILE"
    flock 9
    start_shell "$(cmd_get)"
}

case "${1:-}" in
    get)   cmd_get ;;
    set)   shift; cmd_set "$@" ;;
    next)  cmd_next ;;
    apply) cmd_apply ;;
    *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
