#!/usr/bin/env bash
# Switch the desktop shell layer while keeping Hyprland, hypridle/hyprlock and
# hyprsunset untouched.
#
#   rice-shell get           print the active shell
#   rice-shell set <shell>   switch to: noctalia | classic
#   rice-shell next          toggle noctalia ⇄ classic
#   rice-shell apply         start the saved shell without waiting (login)
#
# Each shell is a systemd user target (~/.config/systemd/user/rice-*.target)
# that Conflicts= with the others, so starting one stops the rest, and all of
# its daemons start in parallel:
#   noctalia = Noctalia, the everyday shell   (rice-noctalia.target)
#   classic  = waybar + eww + swaync + awww   (rice-classic.target, fallback)

set -euo pipefail

SHELLS=(noctalia classic)
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rice"
STATE_FILE="$STATE_DIR/shell"

die() { echo "rice-shell: $*" >&2; exit 1; }

cmd_get() {
    local s
    s="$(cat "$STATE_FILE" 2>/dev/null || true)"
    case "$s" in classic|noctalia) echo "$s" ;; *) echo noctalia ;; esac
}

prepare() {
    # Palette files must exist before any bar/CSS that imports them starts.
    "$HOME/.local/bin/rice-wall" init || true
    # Clear failures left from the other shell (e.g. refused swaync activations).
    systemctl --user reset-failed 'rice-*' swaync.service waybar.service 2>/dev/null || true
}

after_start() {  # background follow-ups once the shell is starting
    # The wallpaper daemons restore their own last image; this only redraws
    # if the saved wallpaper changed while another shell was active.
    setsid -f "$HOME/.local/bin/rice-wall" restore >/dev/null 2>&1
}

cmd_apply() {
    prepare
    systemctl --user start --no-block "rice-$(cmd_get).target"
    after_start
}

cmd_set() {
    local target="${1:?usage: rice-shell set <noctalia|classic>}"
    [[ " ${SHELLS[*]} " == *" $target "* ]] || die "unknown shell: $target"

    mkdir -p "$STATE_DIR"
    printf '%s\n' "$target" > "$STATE_FILE"
    prepare
    systemctl --user start "rice-$target.target"
    after_start
    notify-send -a rice -i preferences-desktop-theme "Desktop shell" "Switched to $target" 2>/dev/null || true
}

cmd_next() {
    local current i
    current="$(cmd_get)"
    for i in "${!SHELLS[@]}"; do
        if [[ "${SHELLS[$i]}" == "$current" ]]; then
            cmd_set "${SHELLS[$(( (i + 1) % ${#SHELLS[@]} ))]}"
            return
        fi
    done
    cmd_set noctalia
}

case "${1:-}" in
    get)   cmd_get ;;
    set)   shift; cmd_set "$@" ;;
    next)  cmd_next ;;
    apply) cmd_apply ;;
    *) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
