#!/usr/bin/env bash
# Toggle hypridle. The flag file tells hypridle-power-watcher not to restart it
# on AC changes; it lives in $XDG_RUNTIME_DIR so idle is re-enabled every login.
set -euo pipefail

FLAG="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypridle.disabled"
WAYBAR_IDLE_SIGNAL=10

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Idle" "$1"
  else
    echo "Idle: $1"
  fi
}

if systemctl --user is-active --quiet hypridle.service; then
  touch "$FLAG"
  systemctl --user stop hypridle.service
  notify "Disabled"
else
  rm -f "$FLAG"
  systemctl --user start hypridle.service
  notify "Enabled"
fi

pkill -RTMIN+"$WAYBAR_IDLE_SIGNAL" -x waybar 2>/dev/null || true
