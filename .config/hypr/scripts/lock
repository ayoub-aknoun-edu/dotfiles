#!/usr/bin/env bash
# Lock the session with Noctalia's lock screen.
# Used by Super+L, the power button and hypridle (idle + before sleep).
# Falls back to hyprlock whenever Noctalia isn't running or the lock IPC
# fails, so a lock request never leaves the screen unlocked.
set -euo pipefail

if systemctl --user is-active --quiet noctalia.service; then
    noctalia msg session lock && exit 0
fi

if pgrep -x hyprlock >/dev/null 2>&1; then
    exit 0
fi

exec hyprlock --immediate-render --no-fade-in --config "$HOME/.config/hypr/hyprlock.conf"
