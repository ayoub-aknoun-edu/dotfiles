#!/usr/bin/env bash
# Lock the session with the active shell's lock screen (see rice-shell):
#   noctalia → Noctalia's lock screen
#   classic  → hyprlock
# Used by Super+L, the power button, wlogout and hypridle (idle + before sleep).
# Falls back to hyprlock whenever Noctalia isn't running, so a lock request
# never leaves the screen unlocked.
set -euo pipefail

if [[ "$("$HOME/.local/bin/rice-shell" get 2>/dev/null)" == noctalia ]] \
    && systemctl --user is-active --quiet noctalia.service; then
    noctalia msg session lock && exit 0
fi

if pgrep -x hyprlock >/dev/null 2>&1; then
    exit 0
fi

exec hyprlock --immediate-render --no-fade-in --config "$HOME/.config/hypr/hyprlock.conf"
