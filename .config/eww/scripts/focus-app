#!/usr/bin/env python3
"""
Focus the Hyprland window that sent a notification (eww card click).

Usage: focus-app <notification_id>

The id is looked up in the eww notification cache, so app names (which any
D-Bus client can set) never pass through a shell or into a Lua dispatch.

Strategy (in order):
  1. Walk the process tree from sender-pid up to find a Hyprland client
     (handles browser renderer PIDs for web-app notifications)
  2. Class/title substring match on the app name
  3. Exact pid match (brings tray apps back as a window)
"""
import json, os, re, subprocess, sys

CACHE = f'/run/user/{os.getuid()}/eww_notifications.json'


def get_clients():
    try:
        return json.loads(
            subprocess.check_output(['hyprctl', '-j', 'clients'],
                                    stderr=subprocess.DEVNULL)
        )
    except Exception:
        return []


def get_notification(notif_id):
    try:
        with open(CACHE) as f:
            return next((n for n in json.load(f) if n.get('id') == notif_id), None)
    except (OSError, ValueError):
        return None


def ppid(pid):
    try:
        with open(f'/proc/{pid}/status') as f:
            for line in f:
                if line.startswith('PPid:'):
                    return int(line.split()[1])
    except (IOError, OSError):
        pass
    return None


def find_client_by_pid_tree(start_pid, clients):
    """Walk up the process tree from start_pid; return the first ancestor
    that is a Hyprland client."""
    client_map = {c['pid']: c for c in clients if c.get('pid')}
    pid = start_pid
    seen = set()
    while pid and pid > 1 and pid not in seen:
        seen.add(pid)
        if pid in client_map:
            return client_map[pid]
        pid = ppid(pid)
    return None


def focus(client):
    # Hyprland 0.55+ takes Lua dispatchers; only a validated hex address is
    # interpolated, so nothing user-controlled reaches the Lua parser.
    address = client.get('address', '')
    if not re.fullmatch(r'0x[0-9a-fA-F]+', address):
        return
    subprocess.run(
        ['hyprctl', 'dispatch', f'hl.dsp.focus({{ window = "address:{address}" }})'],
        capture_output=True
    )


def main():
    try:
        notif_id = int(sys.argv[1])
    except (IndexError, ValueError):
        return

    n = get_notification(notif_id)
    if n is None:
        return

    app = (n.get('app') or '').lower()
    pid = n.get('pid') if isinstance(n.get('pid'), int) and n.get('pid') > 0 else None
    clients = get_clients()

    # 1. Process tree from sender-pid
    if pid is not None:
        client = find_client_by_pid_tree(pid, clients)
        if client:
            focus(client)
            return

    # 2. Class/title substring match
    if app:
        for c in clients:
            cls   = c.get('class', '').lower()
            title = c.get('title', '').lower()
            if cls and (app in cls or cls in app or app in title):
                focus(c)
                return

    # 3. Exact pid (tray apps)
    if pid is not None:
        client = next((c for c in clients if c.get('pid') == pid), None)
        if client:
            focus(client)


if __name__ == '__main__':
    main()
