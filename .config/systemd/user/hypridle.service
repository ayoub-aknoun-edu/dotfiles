[Unit]
Description=Hypridle idle management (AC/battery aware)
# Shadows /usr/lib/systemd/user/hypridle.service to pick the AC/battery config.
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/hypridle-launch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
