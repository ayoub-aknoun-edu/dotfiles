[Unit]
Description=DankMaterialShell (rice shell)
# Replaces the packaged dms.service, which is masked here: it declares
# BusName=org.freedesktop.Notifications like swaync.service, and systemd
# refuses to load two units for one bus name. DMS still owns the name at
# runtime. Started via rice-dms.target (~/.local/bin/rice-shell).
PartOf=rice-dms.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/dms run --session
ExecReload=/bin/kill -USR1 $MAINPID
LimitNOFILE=16384:infinity
Restart=on-failure
RestartForceExitStatus=TEMPFAIL
SuccessExitStatus=TEMPFAIL
RestartSec=1.23
TimeoutStopSec=10
