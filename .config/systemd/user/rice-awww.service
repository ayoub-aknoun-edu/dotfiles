[Unit]
Description=awww wallpaper daemon (classic shell)
PartOf=rice-classic.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
# Restores the last image from its cache on its own: the wallpaper is on
# screen as soon as the daemon is up, no `awww img` needed at login.
ExecStart=/usr/bin/awww-daemon
Restart=on-failure
RestartSec=1
