[Unit]
Description=Restart hypridle when AC power state changes
PartOf=graphical-session.target
After=graphical-session.target hypridle.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/hypridle-power-watcher
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
