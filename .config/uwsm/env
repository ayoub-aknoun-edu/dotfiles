# Environment exported by UWSM before Hyprland starts.
# Keep compositor/session identity variables under UWSM's control.

# Cursor
export XCURSOR_SIZE=24
export HYPRCURSOR_SIZE=24

# Theming
# GTK theme/icons come from gsettings + gtk-{3,4}.0/settings.ini (adw-gtk3-dark).
# Don't set GTK_THEME: it overrides that and breaks libadwaita apps.
#
# Qt: left on Qt's default portal theme, which follows the dark color-scheme.
# KvAdwaitaDark (Kvantum/kvantum.kvconfig) isn't installed and qt6ct has no
# config, so forcing them would make Qt apps light. To opt in:
#   yay -S kvantum-theme-libadwaita-git && qt6ct   (pick kvantum style)
# export QT_STYLE_OVERRIDE=kvantum
# export QT_QPA_PLATFORMTHEME=qt6ct
export XDG_ICON_THEME=Papirus-Dark
export XDG_MENU_PREFIX=arch-

# Toolkit Wayland hints
export GDK_BACKEND=wayland,x11,*
export QT_QPA_PLATFORM='wayland;xcb'
export SDL_VIDEODRIVER=wayland,x11
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export OZONE_PLATFORM=wayland
